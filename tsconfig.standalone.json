{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist-standalone",
    "declaration": false,
    "sourceMap": false,
    "rootDir": "./src",
    "ignoreDeprecations": "6.0",
    "strictPropertyInitialization": false
  },
  "include": ["src/main.standalone.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "dist", "frontend", "**/*.spec.ts"]
}
